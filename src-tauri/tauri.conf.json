{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Session Converter",
  "version": "0.1.6",
  "identifier": "io.github.rw0104.session-converter",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Session Converter",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; media-src 'none'; object-src 'none'; worker-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Convert local credential formats without uploading them.",
    "longDescription": "A local-first converter for ChatGPT Session, CPA, sub2api, Codex, Cockpit, 9router, AxonHub and Codex-Manager credential formats.",
    "copyright": "Copyright © 2026 Session Converter contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCNDlERjAwQjk1M0FFNjcKUldSbnJsTzVBTjlKTzR3SzFiRTRuRUx1a3YwNitQSWQ3T1VjRGhIblVBbDN3YmdVZHhwdnRqZFEK",
      "endpoints": [
        "https://github.com/rw0104/session-converter-desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
